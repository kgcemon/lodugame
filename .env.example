# Copy to .env (never commit .env). Every value below is a placeholder.

# ---- Server ----
PORT=3001
NODE_ENV=development
# The public URL players open. Used in invitation links and in emails.
# Dev (Vite): http://localhost:5173   Production example: https://ludo.your-domain.example
APP_BASE_URL=http://localhost:5173
# Extra browser origins allowed to call the API / open sockets (comma-separated).
# CORS_ORIGIN=https://www.your-domain.example# Set to true when running behind a reverse proxy (nginx, Caddy, a PaaS router) so client IPs are correct.
# TRUST_PROXY=true
# Secure cookies are on automatically when NODE_ENV=production (HTTPS required).
# COOKIE_SECURE=true

# ---- Database ----
# Connection string, SERVER ONLY. The scheme picks the engine.
# PostgreSQL (Supabase, Neon, RDS, local postgres...):
# Supabase: Project Settings -> Database -> Connection string (URI), using the database password.
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# MySQL 8.0.16+ or MariaDB 10.4.2+ (CloudPanel, cPanel, XAMPP, RDS...). URL-encode special
# characters in the password (e.g. @ -> %40). Create the database first, empty, utf8mb4.
# DATABASE_URL=mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME
# Without DATABASE_URL the server uses PGlite (PostgreSQL in WebAssembly) stored in this folder:
PGLITE_DIR=./data/pglite

# ---- Accounts ----
# Emails that become administrators when they register or sign in (comma-separated).
ADMIN_EMAILS=you@your-domain.example
# Require a verified email before joining paid matches.
REQUIRE_EMAIL_VERIFICATION=false
# Per-IP limits on account endpoints.
REGISTER_LIMIT=5
LOGIN_LIMIT=10

# ---- Gems (Google Play in-app purchases) ----
# Service account key with access to the app in Play Console: a path to the JSON file, or the JSON itself.
# Without it the gem shop says purchases are not set up yet (re-rolls still work with gems given by an admin).
# GOOGLE_PLAY_SERVICE_ACCOUNT=/home/USER/secrets/play-service-account.json
# Android package name of the app (must match app/app/build.gradle applicationId).
GOOGLE_PLAY_PACKAGE=com.ludox.game

# ---- Email ----
# Without RESEND_API_KEY, verification and reset links are printed to the server console (development only).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Ludo 3D <no-reply@your-domain.example>

# ---- Client (Vite, read at build time) ----
# Only needed when the site is hosted on a different origin than the game server.
# VITE_SERVER_URL=https://game.your-domain.example
